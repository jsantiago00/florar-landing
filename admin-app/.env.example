# Contraseña para entrar a /admin y guardar cambios.
ADMIN_PASSWORD=cambiar-esta-clave

# Estas dos las completa Vercel automáticamente cuando conectás una
# base de datos Redis al proyecto (pestaña Storage -> Marketplace ->
# Redis, integración de Upstash). No hace falta escribirlas a mano
# en producción, Vercel las agrega solo al vincular la base.
KV_REST_API_URL=
KV_REST_API_TOKEN=

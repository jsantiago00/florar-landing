# Contraseña para entrar a /admin y guardar cambios.
ADMIN_PASSWORD=cambiar-esta-clave

# La completa Vercel automáticamente cuando conectás una base de datos
# Redis al proyecto (pestaña Storage -> Marketplace -> Redis). No hace
# falta escribirla a mano en producción, Vercel la agrega sola al
# vincular la base.
REDIS_URL=
